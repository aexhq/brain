{
  "name": "@aexhq/brain-docs",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && next build",
    "dev": "npm run generate && next dev --hostname 127.0.0.1",
    "start": "python -m http.server 3000 --bind 127.0.0.1 --directory out",
    "types:check": "next typegen && tsc --noEmit",
    "test": "node --test scripts/site.test.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.17.3",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-openapi": "12.4.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.3",
    "lucide-react": "1.50.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
