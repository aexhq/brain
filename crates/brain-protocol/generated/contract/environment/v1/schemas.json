{
  "$defs": {
    "EnvironmentCommand": {
      "properties": {
        "contract": {
          "const": "environment/v1"
        },
        "operation": {
          "$ref": "#/$defs/EnvironmentOperation"
        }
      },
      "required": [
        "contract",
        "operation"
      ],
      "type": "object"
    },
    "EnvironmentName": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "EnvironmentOperation": {
      "description": "One operation on an Environment, named by `(session_id, environment, sequence)`.",
      "properties": {
        "environment": {
          "$ref": "#/$defs/EnvironmentName"
        },
        "request": {
          "$ref": "#/$defs/EnvironmentRequest"
        },
        "sequence": {
          "description": "The sequence of the journal record that started this operation. With\n`session_id` it names the operation: a redelivery carries the same pair, so a\nreceiver that already answered it can say so.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "sequence",
        "environment",
        "session_id",
        "request"
      ],
      "type": "object"
    },
    "EnvironmentReceipt": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "accepted",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": true,
            "type": {
              "const": "progress",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "output": true,
            "type": {
              "const": "result",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "message": {
              "maxLength": 4096,
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "type": {
              "const": "failure",
              "type": "string"
            }
          },
          "required": [
            "type",
            "code",
            "message",
            "retryable"
          ],
          "type": "object"
        },
        {
          "properties": {
            "message": {
              "maxLength": 4096,
              "type": "string"
            },
            "type": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentRequest": {
      "description": "What Brain asks an Environment to do. An Environment provides resources and learns\nwhat runs in it only when asked to run it: setup carries its configuration and the\nneeds of everything placed there; execute carries an opaque implementation and input.",
      "oneOf": [
        {
          "properties": {
            "configuration": true,
            "needs": {
              "description": "Every need of every Tool and the Agentloop placed here, as URIs. The\nEnvironment refuses at setup what it cannot honour, naming the URI.",
              "items": {
                "format": "uri",
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "type": {
              "const": "setup",
              "type": "string"
            }
          },
          "required": [
            "type",
            "configuration",
            "needs"
          ],
          "type": "object"
        },
        {
          "properties": {
            "input": true,
            "name": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "type": {
              "const": "call",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "input"
          ],
          "type": "object"
        },
        {
          "properties": {
            "callback": {
              "$ref": "#/$defs/ExecutionCallback",
              "description": "Sent only during execution, never journaled."
            },
            "deadline_ms": {
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "implementation": {
              "description": "Interpreted only by the Environment; fixes the runtime entrypoint and configuration."
            },
            "input": true,
            "needs": {
              "items": {
                "format": "uri",
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array",
              "uniqueItems": true
            },
            "type": {
              "const": "execute",
              "type": "string"
            }
          },
          "required": [
            "type",
            "implementation",
            "needs",
            "input",
            "deadline_ms"
          ],
          "type": "object"
        },
        {
          "properties": {
            "target_sequence": {
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "const": "cancel",
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_sequence"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "detach",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "teardown",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentResponse": {
      "properties": {
        "contract": {
          "const": "environment/v1"
        },
        "receipt": {
          "$ref": "#/$defs/EnvironmentReceipt"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "contract",
        "sequence",
        "receipt"
      ],
      "type": "object"
    },
    "ExecutionCallback": {
      "additionalProperties": false,
      "description": "Where a remote invocation reaches only its caller-granted services.",
      "properties": {
        "methods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "token": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url",
        "token",
        "methods"
      ],
      "type": "object"
    },
    "SessionId": {
      "pattern": "^ses_[A-Za-z0-9]{20,32}$",
      "type": "string"
    }
  },
  "$id": "https://github.com/aexhq/brain/crates/brain-protocol/generated/contract/environment/v1/schemas.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/EnvironmentCommand"
    },
    {
      "$ref": "#/$defs/EnvironmentResponse"
    }
  ],
  "title": "Brain Environment v1"
}
