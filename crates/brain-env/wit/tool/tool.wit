package brain:tool@0.2.0;

interface types {
  // One call. The call is named by the session id and sequence Brain records for
  // it; a Tool that wants an identifier for its own logging reads them from Brain.
  record invocation {
    input-json: string,
    configuration-json: string,
    // Zero means no deadline.
    deadline-at-ms: u64,
  }

  record tool-error {
    code: string,
    message: string,
  }
}

interface host {
  use types.{tool-error};

  emit: func(kind: string, payload-json: string) -> result<u64, tool-error>;
  // Outcomes use the session contract. Each call commits before returning.
  emit-result: func(outcome-json: string) -> result<u64, tool-error>;
  // Release dispatch while the invocation keeps running its asynchronous work.
  returned: func(outcome-json: option<string>) -> result<u64, tool-error>;
  // Close the execution after all its results. Further emissions are refused.
  finish: func(outcome-json: option<string>) -> result<u64, tool-error>;
  // Best-effort operational diagnostics. Never enters the session journal or model input.
  telemetry: func(record-json: string);
}

world tool {
  use types.{invocation, tool-error};
  import host;
  export run: func(input: invocation) -> result<string, tool-error>;
}
