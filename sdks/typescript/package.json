{
  "name": "@aexhq/brain",
  "version": "3.0.0",
  "description": "Typed client for Brain sessions, tools, checkpoints, and event streams",
  "license": "MIT",
  "homepage": "https://aexhq.github.io/brain/docs/sdks/typescript/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/brain.git",
    "directory": "sdks/typescript"
  },
  "bugs": {
    "url": "https://github.com/aexhq/brain/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./cli": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/build-cli.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0"
  },
  "bin": {
    "brain": "./dist/cli.mjs"
  }
}
