{
  "name": "@aexhq/brain",
  "version": "4.0.0",
  "description": "Typed client for Brain sessions, tools, checkpoints, and event streams",
  "license": "MIT",
  "homepage": "https://aexhq.github.io/brain/docs/sdks/typescript/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/brain.git",
    "directory": "sdks/typescript"
  },
  "bugs": {
    "url": "https://github.com/aexhq/brain/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./cli": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc && node ../../cli/scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "generate": "node scripts/generate.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "commander": "15.1.0",
    "openapi-fetch": "0.17.0"
  },
  "bin": {
    "brain": "./dist/cli.mjs"
  }
}
