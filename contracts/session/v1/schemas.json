{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aexhq/brain/contracts/session/v1/schemas.json",
  "title": "Brain Session API v1",
  "$defs": {
    "Identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "Identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "AgentloopIdentity": { "$ref": "#/$defs/Identity" },
    "SessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9]{20,32}$" },
    "ToolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema"],
      "properties": {
        "name": { "$ref": "#/$defs/Identifier" },
        "description": { "type": "string", "maxLength": 8192 },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" }
      }
    },
    "RequestedToolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environment_id", "remote_tool_id", "tool_configuration", "grant"],
      "properties": {
        "name": { "$ref": "#/$defs/Identifier" },
        "environment_id": { "$ref": "#/$defs/Identifier" },
        "remote_tool_id": { "$ref": "#/$defs/Identifier" },
        "tool_configuration": {},
        "grant": {}
      }
    },
    "EnvironmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "configuration", "lifecycle_policy"],
      "properties": {
        "environment_id": { "$ref": "#/$defs/Identifier" },
        "configuration": {},
        "lifecycle_policy": { "enum": ["session", "shared", "external"] }
      }
    },
    "ModelSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "api_key"],
      "properties": {
        "provider": { "$ref": "#/$defs/Identifier" },
        "name": { "type": "string", "pattern": "^\\S{1,256}$", "maxLength": 256 },
        "api_key": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    },
    "ModelPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "tools"],
      "properties": {
        "system": { "type": "string", "maxLength": 131072 },
        "tools": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/ToolDefinition" } },
        "response_format": {}
      }
    },
    "CreateSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentloop_identity", "brain_configuration", "model", "presentation", "environments", "tool_bindings"],
      "properties": {
        "agentloop_identity": { "$ref": "#/$defs/AgentloopIdentity" },
        "brain_configuration": {},
        "model": { "$ref": "#/$defs/ModelSelection" },
        "presentation": { "$ref": "#/$defs/ModelPresentation" },
        "environments": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/EnvironmentRequirement" } },
        "tool_bindings": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/RequestedToolBinding" } },
        "history": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/HistoryEvent" } }
      }
    },
    "HistoryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event_type", "data"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "recorded_at_ms": { "type": "integer", "minimum": 0 },
        "event_type": { "$ref": "#/$defs/Identifier" },
        "data": {}
      }
    },
    "MessageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": { "content": {} }
    },
    "EnvironmentCallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": { "input": {} }
    },
    "EnvironmentCallResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output"],
      "properties": { "output": {} }
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "journal_id", "status", "through_sequence", "presentation_identity"],
      "properties": {
        "session_id": { "$ref": "#/$defs/SessionId" },
        "journal_id": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["creating", "idle", "running", "ended", "failed"] },
        "through_sequence": { "type": "integer", "minimum": 0 },
        "presentation_identity": { "$ref": "#/$defs/Identity" }
      }
    },
    "SessionList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions"],
      "properties": { "sessions": { "type": "array", "items": { "$ref": "#/$defs/Session" } } }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence", "recorded_at_ms", "event_type", "data"],
      "properties": {
        "event_id": { "$ref": "#/$defs/Identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "recorded_at_ms": { "type": "integer", "minimum": 0 },
        "event_type": { "$ref": "#/$defs/Identifier" },
        "data": {}
      }
    },
    "EventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "next_cursor"],
      "properties": {
        "events": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/Event" } },
        "next_cursor": { "type": "integer", "minimum": 0 }
      }
    },
    "AgentloopManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "component_identity", "component_bytes"],
      "properties": {
        "contract_version": { "const": "agentloop/v1" },
        "component_identity": { "$ref": "#/$defs/Identity" },
        "component_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "toolchain": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "AgentloopAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "status"],
      "properties": {
        "identity": { "$ref": "#/$defs/Identity" },
        "status": { "enum": ["admitted", "rejected"] },
        "error": { "$ref": "#/$defs/ApiError" }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/Identifier" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "details": {}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract"],
  "properties": { "contract": { "const": "session/v1" } }
}
