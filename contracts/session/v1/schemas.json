{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aexhq/brain/contracts/session/v1/schemas.json",
  "title": "Brain Session API v1",
  "$defs": {
    "Identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "Identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "AgentloopIdentity": { "$ref": "#/$defs/Identity" },
    "SessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9]{20,32}$" },
    "AgentloopRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "configuration"],
      "properties": {
        "identity": { "$ref": "#/$defs/AgentloopIdentity" },
        "configuration": {}
      }
    },
    "CapabilityName": { "enum": ["exec", "fs", "net", "js", "page"] },
    "ToolPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "enum": ["esm", "component"] },
        "identity": { "$ref": "#/$defs/Identity" }
      }
    },
    "BoundTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema", "requires", "binding_names"],
      "properties": {
        "name": { "$ref": "#/$defs/Identifier" },
        "description": { "type": "string", "maxLength": 8192 },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/CapabilityName" } },
        "binding_names": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "hosting": { "enum": ["provisioned", "callback", "client"] },
        "payload": { "$ref": "#/$defs/ToolPayload" },
        "environment_id": { "$ref": "#/$defs/Identifier" }
      },
      "allOf": [
        { "if": { "required": ["hosting"], "properties": { "hosting": { "const": "callback" } } }, "then": { "not": { "required": ["payload"] } } },
        { "if": { "required": ["hosting"], "properties": { "hosting": { "const": "client" } } }, "then": { "allOf": [ { "not": { "required": ["payload"] } }, { "not": { "required": ["environment_id"] } } ] } },
        { "if": { "not": { "required": ["hosting"], "properties": { "hosting": { "const": "client" } } } }, "then": { "required": ["environment_id"] } }
      ]
    },
    "ExecGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms_max": { "type": "integer", "minimum": 1 },
        "output_bytes_max": { "type": "integer", "minimum": 1 }
      }
    },
    "FsGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": { "root": { "type": "string", "minLength": 1, "maxLength": 4096 } }
    },
    "NetGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": { "allow": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 256 } } }
    },
    "JsGrant": { "type": "object", "additionalProperties": false, "properties": {} },
    "PageGrant": { "type": "object", "additionalProperties": false, "properties": {} },
    "GrantSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exec": { "$ref": "#/$defs/ExecGrant" },
        "fs": { "$ref": "#/$defs/FsGrant" },
        "net": { "$ref": "#/$defs/NetGrant" },
        "js": { "$ref": "#/$defs/JsGrant" },
        "page": { "$ref": "#/$defs/PageGrant" }
      }
    },
    "EnvironmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "configuration", "lifecycle_policy"],
      "properties": {
        "environment_id": { "$ref": "#/$defs/Identifier" },
        "configuration": {},
        "lifecycle_policy": { "enum": ["session", "shared", "external"] },
        "grants": { "$ref": "#/$defs/GrantSet" },
        "bindings": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/Identifier" },
          "additionalProperties": { "type": "string", "maxLength": 32768 }
        }
      }
    },
    "ModelSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "api_key"],
      "properties": {
        "provider": { "$ref": "#/$defs/Identifier" },
        "name": { "type": "string", "pattern": "^\\S{1,256}$", "maxLength": 256 },
        "api_key": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    },
    "CreateSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentloop", "model", "tools", "environments"],
      "properties": {
        "agentloop": { "$ref": "#/$defs/AgentloopRef" },
        "model": { "$ref": "#/$defs/ModelSelection" },
        "system": { "type": "string", "maxLength": 131072 },
        "tools": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/BoundTool" } },
        "response_format": {},
        "environments": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/EnvironmentRequirement" } },
        "history": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/HistoryEvent" } }
      }
    },
    "HistoryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event_type", "data"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "recorded_at_ms": { "type": "integer", "minimum": 0 },
        "event_type": { "$ref": "#/$defs/Identifier" },
        "data": {}
      }
    },
    "UserInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": { "message": { "type": "string", "minLength": 1 } }
    },
    "MessageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": { "input": { "$ref": "#/$defs/UserInput" } }
    },
    "EnvironmentCallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": { "input": {} }
    },
    "EnvironmentCallResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output"],
      "properties": { "output": {} }
    },
    "OperationId": { "type": "string", "pattern": "^op_[0-9a-f]{32}$" },
    "Outcome": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": { "status": { "const": "ok" }, "value": {} } },
        { "type": "object", "additionalProperties": false, "required": ["status", "error"], "properties": { "status": { "const": "error" }, "error": { "$ref": "#/$defs/OutcomeError" } } },
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "timeout" } } },
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "cancelled" } } }
      ]
    },
    "OutcomeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/Identifier" },
        "message": { "type": "string", "maxLength": 4096 },
        "details": {}
      }
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "journal_id", "status", "last_sequence", "config_hash"],
      "properties": {
        "session_id": { "$ref": "#/$defs/SessionId" },
        "journal_id": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["creating", "idle", "running", "ended", "failed"] },
        "last_sequence": { "type": "integer", "minimum": 0 },
        "config_hash": { "$ref": "#/$defs/Identity" }
      }
    },
    "SessionList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions"],
      "properties": { "sessions": { "type": "array", "items": { "$ref": "#/$defs/Session" } } }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence", "recorded_at_ms", "event_type", "data"],
      "properties": {
        "event_id": { "$ref": "#/$defs/Identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "recorded_at_ms": { "type": "integer", "minimum": 0 },
        "event_type": { "$ref": "#/$defs/Identifier" },
        "data": {}
      }
    },
    "EventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "next_cursor"],
      "properties": {
        "events": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/Event" } },
        "next_cursor": { "type": "integer", "minimum": 0 }
      }
    },
    "AgentloopManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "component_identity", "component_bytes"],
      "properties": {
        "contract_version": { "const": "agentloop/v1" },
        "component_identity": { "$ref": "#/$defs/Identity" },
        "component_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "toolchain": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "AgentloopAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "status"],
      "properties": {
        "identity": { "$ref": "#/$defs/Identity" },
        "status": { "enum": ["admitted", "rejected"] },
        "error": { "$ref": "#/$defs/ApiError" }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/Identifier" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "details": {}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract"],
  "properties": { "contract": { "const": "session/v1" } }
}
