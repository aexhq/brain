{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aexhq/brain/contracts/session/v1/schemas.json",
  "title": "Brain session API v1 types",
  "description": "Component types of the public session API. Paths are in openapi.yaml, which references these by $ref. Session lifecycle and current-turn activity are independent axes. Absent provider counters are absent, never zero.",
  "$defs": {
    "SessionId": {
      "type": "string",
      "pattern": "^ses_[A-Za-z0-9]{20,32}$"
    },
    "TurnId": {
      "type": "string",
      "pattern": "^trn_[A-Za-z0-9]{20,32}$"
    },
    "AgentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "\"root\" for the session's root agent; subagents get brain-minted ids."
    },
    "CallId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Brain-minted id of one durable Tool operation. Managed Hands receive the same operation_id."
    },
    "ModelAttemptId": {
      "type": "string",
      "pattern": "^att_[A-Za-z0-9]{20,32}$",
      "description": "Brain-minted identity of one provisional provider attempt."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339, UTC."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SessionState": {
      "type": "string",
      "enum": [
        "open",
        "ending",
        "ended",
        "deleting",
        "deleted",
        "failed"
      ],
      "description": "Lifecycle only. Whether a turn is running is reported separately as turn_state."
    },
    "SessionTurnState": {
      "type": "string",
      "enum": [
        "idle",
        "running"
      ],
      "description": "Current-turn activity, independent from session lifecycle."
    },
    "Provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "deepseek",
        "moonshot",
        "xai",
        "openai_compatible"
      ],
      "description": "openai and anthropic are certified; the rest are available uncertified."
    },
    "ModelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "api_key"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Provider model id, e.g. \"claude-sonnet-5\" or \"gpt-5\"."
        },
        "api_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "writeOnly": true,
          "description": "BYOK. Encrypted per session, never returned, never logged."
        },
        "base_url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri",
          "description": "Override the provider endpoint (required for openai_compatible)."
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "context_window_tokens": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 2000000,
          "description": "Immutable model context window. Omission seals the conservative neutral default of 32768 tokens; custom model names are never guessed from a mutable catalog."
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "Sealed into supported OpenAI-family Chat profiles. The Anthropic MVP profile rejects this field before any external effect instead of silently dropping it."
        }
      }
    },
    "ModelInfo": {
      "type": "object",
      "required": [
        "provider",
        "name",
        "context_window_tokens"
      ],
      "description": "ModelConfig without the key.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "name": {
          "type": "string"
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "context_window_tokens": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 2000000,
          "description": "Effective immutable context window used for request admission and semantic compaction."
        }
      }
    },
    "ToolName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
    },
    "ToolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input_schema",
        "contract_digest"
      ],
      "description": "The model-visible half of one Tool. Array order is preserved exactly in the immutable model prefix.",
      "properties": {
        "name": {
          "$ref": "#/$defs/ToolName"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "input_schema": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "output_schema": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "contract_digest": {
          "$ref": "#/$defs/Sha256Hex"
        }
      }
    },
    "ExternalToolScope": {
      "type": "string",
      "enum": [
        "root",
        "all"
      ],
      "description": "Which agents may call a trusted server capability."
    },
    "ExternalToolCompletion": {
      "type": "string",
      "enum": [
        "continue",
        "return_direct"
      ],
      "description": "continue returns the result to the model. return_direct may complete or fail the turn without another model call."
    },
    "ExternalToolEffect": {
      "type": "string",
      "enum": [
        "opaque",
        "replay_safe"
      ],
      "description": "replay_safe promises that repeating the same session_id and call_id returns the same logical result."
    },
    "AexManagedToolExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bundle_digest",
        "required_env"
      ],
      "description": "A digest-sealed executable in the session's default Aex-managed realm.",
      "properties": {
        "kind": {
          "type": "string",
          "const": "aex_managed"
        },
        "bundle_digest": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "required_env": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": "Environment-key names only. Secret values never enter the seal."
        }
      }
    },
    "CustomerAppToolExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "registration"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "customer_app"
        },
        "registration": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      }
    },
    "EngineToolExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capability"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "engine"
        },
        "capability": {
          "type": "string",
          "pattern": "^(brain|aex)\\.[A-Za-z0-9_.:-]{1,120}$"
        }
      }
    },
    "ToolExecutor": {
      "oneOf": [
        {
          "$ref": "#/$defs/AexManagedToolExecutor"
        },
        {
          "$ref": "#/$defs/CustomerAppToolExecutor"
        },
        {
          "$ref": "#/$defs/EngineToolExecutor"
        }
      ]
    },
    "ToolConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "executor"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/ToolDefinition"
        },
        "executor": {
          "$ref": "#/$defs/ToolExecutor"
        }
      }
    },
    "ToolBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksum",
        "content_base64",
        "bytes",
        "media_type"
      ],
      "description": "Create-time-only bundle bytes. Brain stages these outside the journal, then discards this representation.",
      "properties": {
        "checksum": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "content_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "writeOnly": true,
          "maxLength": 5592408
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "media_type": {
          "type": "string",
          "const": "application/javascript+esm"
        }
      }
    },
    "ToolsConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sealed at create with the rest of the prefix. Omitted tools default to an empty set.",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/ToolConfig"
          },
          "description": "The exact ordered native Tool grant. Omitted or empty means no native tools."
        }
      }
    },
    "StorageInfo": {
      "type": "object",
      "required": [
        "session_storage_bytes",
        "upload_reserved_bytes"
      ],
      "description": "Billed storage, visible from day one.",
      "properties": {
        "session_storage_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Durable objects scoped to the session."
        },
        "upload_reserved_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Outstanding staged upload bytes held against the sealed session quota until staging cleanup completes. These bytes are not yet published session objects."
        }
      }
    },
    "SessionFailure": {
      "type": "object",
      "required": [
        "code",
        "message",
        "at"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "binding_conflict",
            "provider_unusable",
            "hand_unavailable",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Session": {
      "type": "object",
      "required": [
        "id",
        "root_id",
        "depth",
        "object",
        "state",
        "turn_state",
        "shape",
        "model",
        "storage",
        "last_seq",
        "created_at",
        "updated_at",
        "turns",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/SessionId"
        },
        "parent_id": {
          "$ref": "#/$defs/SessionId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Optional customer-visible task name for a child session."
        },
        "context_fork": {
          "$ref": "#/$defs/ContextFork"
        },
        "root_id": {
          "$ref": "#/$defs/SessionId"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "last_seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Authoritative durable journal high-water mark used for tenant discovery and delta folding."
        },
        "object": {
          "type": "string",
          "enum": [
            "session"
          ]
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "turn_state": {
          "$ref": "#/$defs/SessionTurnState"
        },
        "turn_phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable recovery/dispatch phase when a turn is running. Absent while idle."
        },
        "shape": {
          "type": "string",
          "const": "1gb",
          "description": "Authoritative immutable execution shape inherited by every child. The hosted alpha supports only 1gb."
        },
        "model": {
          "$ref": "#/$defs/ModelInfo"
        },
        "storage": {
          "$ref": "#/$defs/StorageInfo"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "last_message_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "current_turn": {
          "$ref": "#/$defs/TurnId"
        },
        "failure": {
          "$ref": "#/$defs/SessionFailure"
        },
        "metadata": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          },
          "description": "Customer key/value; up to 16 pairs."
        }
      }
    },
    "SessionList": {
      "type": "object",
      "required": [
        "object",
        "data",
        "has_more"
      ],
      "properties": {
        "object": {
          "type": "string",
          "enum": [
            "list"
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Session"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string"
        }
      }
    },
    "NetworkPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outbound"],
          "properties": { "outbound": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outbound"],
          "properties": { "outbound": { "const": "public" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outbound", "destinations"],
          "properties": {
            "outbound": { "const": "allowlist" },
            "destinations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["host", "ports", "protocol"],
                    "properties": {
                      "host": { "type": "string", "minLength": 1, "maxLength": 253 },
                      "ports": { "type": "array", "prefixItems": [{ "type": "integer", "const": 443 }], "minItems": 1, "maxItems": 1 },
                      "protocol": { "const": "tls" }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cidr", "ports", "protocol"],
                    "properties": {
                      "cidr": { "type": "string", "minLength": 3, "maxLength": 49 },
                      "ports": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "uniqueItems": true,
                        "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
                      },
                      "protocol": { "const": "tcp" }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "description": "Immutable direct outbound ceiling. Omission means none."
    },
    "CustomerClientConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "submit_retries": { "type": "integer", "minimum": 0, "maximum": 8, "default": 1 }
      }
    },
    "ChildLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 8, "default": 4 },
        "max_direct_children": { "type": "integer", "minimum": 0, "maximum": 128, "default": 32 },
        "max_descendants": { "type": "integer", "minimum": 0, "maximum": 1024, "default": 256 }
      }
    },
    "ContextFork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_session_id",
        "source_context_generation",
        "source_through_sequence",
        "mode",
        "resolved_turns",
        "source_projection_digest"
      ],
      "properties": {
        "source_session_id": { "$ref": "#/$defs/SessionId" },
        "source_context_generation": { "type": "integer", "minimum": 0 },
        "source_through_sequence": { "type": "integer", "minimum": 0 },
        "mode": { "type": "string", "enum": ["all", "none", "last_n"] },
        "last_n": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "resolved_turns": { "type": "integer", "minimum": 0 },
        "source_projection_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "description": "Immutable pointer to the exact bounded parent model projection inherited at child admission. It never embeds parent prompt bytes."
    },
    "CreateSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "description": "Everything here except metadata is part of the immutable prefix: it cannot change for the life of the session.",
      "properties": {
        "model": {
          "$ref": "#/$defs/ModelConfig"
        },
        "system_prompt": {
          "type": "string",
          "maxLength": 131072
        },
        "tools": {
          "$ref": "#/$defs/ToolsConfig"
        },
        "tool_bundles": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/ToolBundle"
          },
          "writeOnly": true,
          "description": "Bounded bundle payloads referenced by tools.items. Never part of the model prefix or journal."
        },
        "secrets": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "additionalProperties": { "type": "string", "maxLength": 2048 },
          "writeOnly": true,
          "description": "Write-only values for required managed Tool environment names; encrypted in custody."
        },
        "network": {
          "$ref": "#/$defs/NetworkPolicy"
        },
        "provider_recovery_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "default": 1
        },
        "client": {
          "$ref": "#/$defs/CustomerClientConfig"
        },
        "children": {
          "$ref": "#/$defs/ChildLimits"
        },
        "metadata": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    },
    "ContentPart": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "text"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "workspace_file"
              ]
            },
            "path": {
              "type": "string",
              "description": "A file already in the workspace; the model is told about it."
            }
          }
        }
      ]
    },
    "MessageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/ContentPart"
              }
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "MessageAccepted": {
      "type": "object",
      "required": [
        "session_id",
        "turn_id",
        "seq"
      ],
      "description": "The turn was admitted and journaled. Follow it on GET /events?after=<seq-1>.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Journal sequence of the turn.started event."
        }
      }
    },
    "ExternalToolCallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "turn_id",
        "agent_id",
        "call_id",
        "name",
        "input",
        "context"
      ],
      "description": "Generic Brain-to-host executor request. Repeating a replay_safe call uses the same session_id and call_id.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "call_id": {
          "$ref": "#/$defs/CallId"
        },
        "name": {
          "type": "string"
        },
        "input": {},
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Trusted, journaled message metadata supplied by the host, not model arguments."
        }
      }
    },
    "ExternalToolDisposition": {
      "type": "string",
      "enum": [
        "continue",
        "complete_turn",
        "fail_turn"
      ]
    },
    "ExternalToolCallResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "content",
        "is_error",
        "disposition"
      ],
      "description": "Generic trusted server-executor result. A successful response carries its structured Tool output in result. Brain honors terminal dispositions only for a return_direct tool called alone by an allowed agent.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/ToolOutcome"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 98304,
          "description": "Bounded result shown to the model and journaled as the tool result."
        },
        "is_error": {
          "type": "boolean"
        },
        "disposition": {
          "$ref": "#/$defs/ExternalToolDisposition"
        },
        "result": {
          "description": "Structured successful Tool output. Required when outcome is completed and is_error is false; also attached to turn.completed for complete_turn."
        },
        "result_metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "error": {
          "$ref": "#/$defs/ApiError",
          "description": "Turn failure attached to turn.failed when disposition is fail_turn."
        }
      }
    },
    "TurnResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "name",
        "value"
      ],
      "description": "A replayable client-facing result returned directly by a generic external tool.",
      "properties": {
        "call_id": {
          "$ref": "#/$defs/CallId"
        },
        "name": {
          "type": "string"
        },
        "value": {},
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
