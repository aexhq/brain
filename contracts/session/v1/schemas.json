{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aexhq/brain/contracts/session/v1/schemas.json",
  "title": "Brain Session API v1",
  "$defs": {
    "Identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "Identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "AgentloopIdentity": { "$ref": "#/$defs/Identity" },
    "SessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9]{20,32}$" },
    "AgentloopRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "configuration"],
      "properties": {
        "identity": { "$ref": "#/$defs/AgentloopIdentity" },
        "configuration": {}
      }
    },
    "Runtime": { "enum": ["esm", "shell", "http"] },
    "ResourceName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}(:[A-Za-z0-9._-]{1,64})?$" },
    "HttpProgramRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": { "type": "string", "pattern": "^[A-Z]{3,16}$" },
        "url": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "headers": { "type": "object", "propertyNames": { "maxLength": 256 }, "additionalProperties": { "type": "string", "maxLength": 16384 } }
      }
    },
    "Program": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "identity"], "properties": { "kind": { "const": "esm" }, "identity": { "$ref": "#/$defs/Identity" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "identity", "script"], "properties": { "kind": { "const": "shell" }, "identity": { "$ref": "#/$defs/Identity" }, "script": { "type": "string", "minLength": 1, "maxLength": 262144 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "identity", "request"], "properties": { "kind": { "const": "http" }, "identity": { "$ref": "#/$defs/Identity" }, "request": { "$ref": "#/$defs/HttpProgramRequest" } } }
      ]
    },
    "BoundTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema", "needs", "binding_names"],
      "properties": {
        "name": { "$ref": "#/$defs/Identifier" },
        "description": { "type": "string", "maxLength": 8192 },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "needs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/ResourceName" } },
        "binding_names": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "hosting": { "enum": ["provisioned", "client"] },
        "program": { "$ref": "#/$defs/Program" },
        "environment_id": { "$ref": "#/$defs/Identifier" }
      },
      "allOf": [
        { "if": { "required": ["hosting"], "properties": { "hosting": { "const": "client" } } }, "then": { "allOf": [ { "not": { "required": ["program"] } }, { "not": { "required": ["environment_id"] } }, { "properties": { "needs": { "maxItems": 0 } } } ] } },
        { "if": { "not": { "required": ["hosting"], "properties": { "hosting": { "const": "client" } } } }, "then": { "required": ["environment_id"] } }
      ]
    },
    "EnvironmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "configuration", "lifecycle_policy"],
      "properties": {
        "environment_id": { "$ref": "#/$defs/Identifier" },
        "configuration": {},
        "lifecycle_policy": { "enum": ["session", "shared", "external"] },
        "bindings": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/Identifier" },
          "additionalProperties": { "type": "string", "maxLength": 32768 }
        }
      }
    },
    "ModelSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "api_key"],
      "properties": {
        "provider": { "$ref": "#/$defs/Identifier" },
        "name": { "type": "string", "pattern": "^\\S{1,256}$", "maxLength": 256 },
        "api_key": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    },
    "CreateSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentloop", "model", "tools", "environments"],
      "properties": {
        "agentloop": { "$ref": "#/$defs/AgentloopRef" },
        "model": { "$ref": "#/$defs/ModelSelection" },
        "system": { "type": "string", "maxLength": 131072 },
        "tools": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/BoundTool" } },
        "environments": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/EnvironmentRequirement" } },
        "history": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/HistoryEvent" } }
      }
    },
    "HistoryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event_type", "data"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "recorded_at_ms": { "type": "integer", "minimum": 0 },
        "event_type": { "$ref": "#/$defs/Identifier" },
        "data": {}
      }
    },
    "UserInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": { "message": { "type": "string", "minLength": 1 } }
    },
    "MessageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": { "input": { "$ref": "#/$defs/UserInput" } }
    },
    "EnvironmentCallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": { "input": {} }
    },
    "EnvironmentCallResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output"],
      "properties": { "output": {} }
    },
    "Sequence": { "type": "integer", "minimum": 1 },
    "Outcome": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": { "status": { "const": "ok" }, "value": {} } },
        { "type": "object", "additionalProperties": false, "required": ["status", "error"], "properties": { "status": { "const": "error" }, "error": { "$ref": "#/$defs/OutcomeError" } } },
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "timeout" } } },
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "cancelled" } } }
      ]
    },
    "OutcomeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/Identifier" },
        "message": { "type": "string", "maxLength": 4096 },
        "details": {}
      }
    },
    "ShareKey": { "type": "string", "pattern": "^sk\\.ses_[A-Za-z0-9]{20,32}\\.[0-9a-f]{64}$" },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "status", "last_sequence", "share_key"],
      "properties": {
        "session_id": { "$ref": "#/$defs/SessionId" },
        "status": { "enum": ["creating", "idle", "running", "ended", "failed"] },
        "last_sequence": { "type": "integer", "minimum": 0 },
        "share_key": { "$ref": "#/$defs/ShareKey" }
      }
    },
    "SessionList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions"],
      "properties": { "sessions": { "type": "array", "items": { "$ref": "#/$defs/Session" } } }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence", "recorded_at_ms", "event_type", "data"],
      "properties": {
        "event_id": { "$ref": "#/$defs/Identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "recorded_at_ms": { "type": "integer", "minimum": 0 },
        "event_type": { "$ref": "#/$defs/Identifier" },
        "data": {}
      }
    },
    "EventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "next_cursor"],
      "properties": {
        "events": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/Event" } },
        "next_cursor": { "type": "integer", "minimum": 0 }
      }
    },
    "AgentloopManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "component_identity", "component_bytes"],
      "properties": {
        "contract_version": { "const": "agentloop/v1" },
        "component_identity": { "$ref": "#/$defs/Identity" },
        "component_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "toolchain": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "AgentloopAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "status"],
      "properties": {
        "identity": { "$ref": "#/$defs/Identity" },
        "status": { "enum": ["admitted", "rejected"] },
        "error": { "$ref": "#/$defs/ApiError" }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/Identifier" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "details": {}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract"],
  "properties": { "contract": { "const": "session/v1" } }
}
