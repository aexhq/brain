{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aexhq/brain/contracts/hand/contract.json",
  "title": "BrainHandContract",
  "description": "The single current, transport-neutral Brain to Hand receipt contract. The canonical schema digest is the compatibility identity; the wire carries no protocol version.",
  "type": "object",
  "definitions": {
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ObjectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "bytes", "sha256"],
      "properties": {
        "object_id": { "$ref": "#/definitions/Identifier" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/Digest" },
        "media_type": { "type": ["string", "null"], "maxLength": 255 }
      }
    },
    "ObjectTransferAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transfer_id", "object_id", "method", "url", "headers", "expires_at_ms", "max_bytes"],
      "properties": {
        "transfer_id": { "$ref": "#/definitions/Identifier" },
        "object_id": { "$ref": "#/definitions/Identifier" },
        "method": { "type": "string", "enum": ["GET", "PUT"] },
        "url": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "headers": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        },
        "expires_at_ms": { "type": "integer", "minimum": 1 },
        "max_bytes": { "type": "integer", "minimum": 1 }
      },
      "description": "Short-lived, one-purpose transfer capability minted by Brain-owned storage. transfer_id identifies the reservation/capability; object_id is the immutable source or pending destination identity. GET is valid only for import and PUT only for export; Hands never infer an object-store key. Export returns ObjectReference.object_id exactly equal to this sealed object_id."
    },
    "BundleRuntime": {
      "type": "string",
      "enum": ["node22"]
    },
    "BundleDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_digest", "bytes", "runtime", "object", "tool_name", "contract_digest", "required_env"],
      "properties": {
        "bundle_digest": { "$ref": "#/definitions/Digest" },
        "bytes": { "type": "integer", "minimum": 1 },
        "runtime": { "$ref": "#/definitions/BundleRuntime" },
        "object": { "$ref": "#/definitions/ObjectReference" },
        "tool_name": { "$ref": "#/definitions/Identifier" },
        "description": { "type": ["string", "null"], "maxLength": 4096 },
        "contract_digest": { "$ref": "#/definitions/Digest" },
        "required_env": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/Identifier" }
        }
      }
    },
    "BundleFetch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_digest", "url", "headers", "expires_at_ms", "max_bytes"],
      "properties": {
        "bundle_digest": { "$ref": "#/definitions/Digest" },
        "url": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "headers": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        },
        "expires_at_ms": { "type": "integer", "minimum": 1 },
        "max_bytes": { "type": "integer", "minimum": 1 }
      },
      "description": "Short-lived, one-purpose fetch authority supplied only at preparation time; it is not part of the persisted sealed binding."
    },
    "PreparedBindingBundles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_ref", "bundle_digests"],
      "properties": {
        "binding_ref": { "$ref": "#/definitions/Identifier" },
        "bundle_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/Digest" }
        }
      }
    },
    "SecretCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_ref", "expires_at_ms", "env_names"],
      "properties": {
        "capability_ref": { "$ref": "#/definitions/Identifier" },
        "expires_at_ms": { "type": "integer", "minimum": 1 },
        "env_names": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/Identifier" }
        }
      },
      "description": "Opaque, short-lived, one-redemption authority for one session and one physical target generation. The Hand may keep redeemed values only in supervisor memory and inject each binding's declared subset at child spawn. Brain may mint a replacement capability for the same surviving generation after a Hand control-process crash. Secret values never enter this contract, binding registry, journal, receipt or argv."
    },
    "SecretDeliveryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_ref", "hand_id", "session_id", "root_id", "target", "generation_intent"],
      "properties": {
        "capability_ref": { "$ref": "#/definitions/Identifier" },
        "hand_id": { "$ref": "#/definitions/Identifier" },
        "session_id": { "$ref": "#/definitions/Identifier" },
        "root_id": { "$ref": "#/definitions/Identifier" },
        "target": { "$ref": "#/definitions/SandboxTarget" },
        "generation_intent": { "$ref": "#/definitions/Identifier" }
      }
    },
    "ExecutionRealm": {
      "type": "string",
      "enum": ["aex_managed", "customer_app", "engine"]
    },
    "HandCapability": {
      "type": "string",
      "enum": ["execution", "session_preparation", "sandbox_files", "sandbox_control"]
    },
    "RecoveryClass": {
      "type": "string",
      "enum": ["retained", "connection_scoped"]
    },
    "ResolvedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_ref", "hand_id", "realm", "recovery", "capabilities", "limits"],
      "properties": {
        "binding_ref": { "$ref": "#/definitions/Identifier" },
        "hand_id": { "$ref": "#/definitions/Identifier" },
        "realm": { "$ref": "#/definitions/ExecutionRealm" },
        "recovery": { "$ref": "#/definitions/RecoveryClass" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/HandCapability" }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_inline_input_bytes", "max_inline_result_bytes", "max_wait_ms"],
          "properties": {
            "max_inline_input_bytes": { "type": "integer", "minimum": 1 },
            "max_inline_result_bytes": { "type": "integer", "minimum": 1 },
            "max_wait_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "SealedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "session_id", "root_id", "contract_digest", "implementation_identity", "realm", "realm_id", "capability", "policy_digest"],
      "properties": {
        "binding_id": { "$ref": "#/definitions/Identifier" },
        "session_id": { "$ref": "#/definitions/Identifier" },
        "root_id": { "$ref": "#/definitions/Identifier" },
        "contract_digest": { "$ref": "#/definitions/Digest" },
        "implementation_identity": { "$ref": "#/definitions/Digest" },
        "realm": { "$ref": "#/definitions/ExecutionRealm" },
        "realm_id": { "$ref": "#/definitions/Identifier" },
        "capability": { "$ref": "#/definitions/Identifier" },
        "policy_digest": { "$ref": "#/definitions/Digest" },
        "bundle": { "anyOf": [{ "$ref": "#/definitions/BundleDescriptor" }, { "type": "null" }] },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/HandCapability" },
          "default": ["execution"]
        }
      }
    },
    "NetworkCeiling": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "public" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "destinations"],
          "properties": {
            "kind": { "const": "allowlist" },
            "destinations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["host", "ports", "protocol"],
                    "properties": {
                      "host": { "type": "string", "minLength": 1, "maxLength": 253 },
                      "ports": { "type": "array", "prefixItems": [{ "type": "integer", "const": 443 }], "minItems": 1, "maxItems": 1 },
                      "protocol": { "const": "tls" }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cidr", "ports", "protocol"],
                    "properties": {
                      "cidr": { "type": "string", "minLength": 1, "maxLength": 64 },
                      "ports": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "uniqueItems": true,
                        "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
                      },
                      "protocol": { "const": "tcp" }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "ResourceCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_output_bytes"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "OperationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "inline" },
        "value": {}
      },
      "description": "Canonical JSON Tool arguments only. Brain rejects serialized input above 192 KiB before submit. Large data is referenced by storage key, URL, or sandbox path and transferred through typed streaming authorities, never embedded as a managed Tool argument."
    },
    "OperationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_digest", "session_id", "root_id", "turn_id", "caller_id", "fence", "binding_ref", "capability", "input", "deadline_at_ms", "resources", "network", "trace"],
      "properties": {
        "operation_id": { "$ref": "#/definitions/Identifier" },
        "request_digest": { "$ref": "#/definitions/Digest" },
        "session_id": { "$ref": "#/definitions/Identifier" },
        "root_id": { "$ref": "#/definitions/Identifier" },
        "turn_id": { "$ref": "#/definitions/Identifier" },
        "caller_id": { "$ref": "#/definitions/Identifier" },
        "fence": { "type": "integer", "minimum": 1 },
        "generation": { "type": ["string", "null"], "maxLength": 128 },
        "binding_ref": { "$ref": "#/definitions/Identifier" },
        "capability": { "$ref": "#/definitions/Identifier" },
        "input": { "$ref": "#/definitions/OperationInput" },
        "target_ref": { "type": ["string", "null"], "maxLength": 256 },
        "deadline_at_ms": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/ResourceCeiling" },
        "network": { "$ref": "#/definitions/NetworkCeiling" },
        "trace": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 256 },
          "maxProperties": 16
        }
      }
    },
    "OperationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_digest", "target", "generation", "target_ref", "receipt_ref"],
      "properties": {
        "operation_id": { "$ref": "#/definitions/Identifier" },
        "request_digest": { "$ref": "#/definitions/Digest" },
        "target": {
          "$ref": "#/definitions/SandboxTarget",
          "description": "Exact rooted logical target accepted for this execution. Control and acknowledgement calls carry it back so Hand can reconcile its root-keyed target registry without a reverse index or scan."
        },
        "generation": { "$ref": "#/definitions/Identifier" },
        "target_ref": {
          "$ref": "#/definitions/Identifier",
          "description": "Opaque physical target locator paired with generation. It never replaces the rooted logical target."
        },
        "receipt_ref": {
          "$ref": "#/definitions/Identifier",
          "description": "Opaque Hand-issued locator for the accepted physical execution. Brain journals it before observe/cancel/ack; it complements the Hand binding/preparation/target registry and never encodes product routing policy."
        }
      },
      "description": "Durable execution locator carrying both the opaque receipt and the exact rooted target authority required to observe, cancel, acknowledge, and reconcile target loss."
    },
    "OperationState": {
      "type": "string",
      "enum": ["accepted", "running", "terminal", "unknown"]
    },
    "TargetReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "generation", "expires_at_ms"],
      "properties": {
        "target_ref": { "$ref": "#/definitions/Identifier" },
        "generation": { "$ref": "#/definitions/Identifier" },
        "expires_at_ms": { "type": "integer", "minimum": 1 }
      },
      "description": "Hand-issued continuity locator for a materialized target. Brain journals and projects the newest receipt, then supplies target_ref and generation on later operations."
    },
    "TerminalOutcome": {
      "type": "string",
      "enum": ["completed", "failed", "cancelled", "deadline_exceeded", "interrupted"]
    },
    "TerminalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "terminal_digest", "is_error"],
      "properties": {
        "outcome": { "$ref": "#/definitions/TerminalOutcome" },
        "terminal_digest": { "$ref": "#/definitions/Digest" },
        "is_error": { "type": "boolean" },
        "inline": {
          "description": "Inline JSON result. Its RFC 8785 encoding must be at most 94208 bytes; larger data is returned by object/storage key/path."
        },
        "object": { "anyOf": [{ "$ref": "#/definitions/ObjectReference" }, { "type": "null" }] },
        "exit_code": { "type": ["integer", "null"] },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "OutputChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "offset", "text"],
      "properties": {
        "stream": { "type": "string", "enum": ["stdout", "stderr", "progress"] },
        "offset": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "maxLength": 4096 }
      },
      "description": "One bounded output observation emitted by a Hand. Brain treats it as provisional until the terminal receipt is durably journaled."
    },
    "OperationObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "state", "output", "next_cursor"],
      "properties": {
        "operation": { "$ref": "#/definitions/OperationRef" },
        "state": { "$ref": "#/definitions/OperationState" },
        "output": { "type": "array", "items": { "$ref": "#/definitions/OutputChunk" } },
        "next_cursor": { "type": "string", "maxLength": 256 },
        "target": { "anyOf": [{ "$ref": "#/definitions/TargetReceipt" }, { "type": "null" }] },
        "terminal": { "anyOf": [{ "$ref": "#/definitions/TerminalResult" }, { "type": "null" }] }
      }
    },
    "SubmitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "wait_up_to_ms"],
      "properties": {
        "envelope": { "$ref": "#/definitions/OperationEnvelope" },
        "wait_up_to_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "SubmitReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "replayed", "observation"],
      "properties": {
        "operation": { "$ref": "#/definitions/OperationRef" },
        "replayed": { "type": "boolean" },
        "observation": { "$ref": "#/definitions/OperationObservation" }
      }
    },
    "ObserveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "cursor", "wait_ms"],
      "properties": {
        "operation": { "$ref": "#/definitions/OperationRef" },
        "cursor": { "type": "string", "maxLength": 256 },
        "wait_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "CancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "reason"],
      "properties": {
        "operation": { "$ref": "#/definitions/OperationRef" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "CancellationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "accepted", "observation"],
      "properties": {
        "operation": { "$ref": "#/definitions/OperationRef" },
        "accepted": { "type": "boolean" },
        "observation": { "$ref": "#/definitions/OperationObservation" }
      }
    },
    "AcknowledgeTerminalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "terminal_digest"],
      "properties": {
        "operation": { "$ref": "#/definitions/OperationRef" },
        "terminal_digest": { "$ref": "#/definitions/Digest" }
      }
    },
    "Acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acknowledged"],
      "properties": { "acknowledged": { "type": "boolean" } }
    },
    "TargetKind": {
      "type": "string",
      "enum": ["default", "additional"]
    },
    "SandboxTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "session_id", "root_id", "binding_ref"],
      "properties": {
        "kind": { "$ref": "#/definitions/TargetKind" },
        "session_id": { "$ref": "#/definitions/Identifier" },
        "root_id": { "$ref": "#/definitions/Identifier" },
        "binding_ref": { "$ref": "#/definitions/Identifier" },
        "sandbox_id": { "anyOf": [{ "$ref": "#/definitions/Identifier" }, { "type": "null" }] }
      }
    },
    "SandboxState": {
      "type": "string",
      "enum": ["never_materialized", "creating", "running", "suspended", "gone", "terminated"]
    },
    "SandboxStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "state", "expires_at_ms"],
      "properties": {
        "target": { "$ref": "#/definitions/SandboxTarget" },
        "state": { "$ref": "#/definitions/SandboxState" },
        "target_ref": { "anyOf": [{ "$ref": "#/definitions/Identifier" }, { "type": "null" }] },
        "generation": { "type": ["string", "null"], "maxLength": 128 },
        "reason": { "type": ["string", "null"], "maxLength": 512 },
        "changed_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "expires_at_ms": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "FileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "bytes", "modified_at_ms"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "kind": { "type": "string", "enum": ["file", "directory", "symlink"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "anyOf": [{ "$ref": "#/definitions/Digest" }, { "type": "null" }] },
        "modified_at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "SandboxFileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "expected_generation", "path"],
      "properties": {
        "target": { "$ref": "#/definitions/SandboxTarget" },
        "expected_generation": { "$ref": "#/definitions/Identifier" },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "SandboxFileWriteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_digest", "target", "expected_generation", "path", "source", "overwrite"],
      "properties": {
        "operation_id": { "$ref": "#/definitions/Identifier" },
        "request_digest": { "$ref": "#/definitions/Digest" },
        "target": { "$ref": "#/definitions/SandboxTarget" },
        "expected_generation": { "$ref": "#/definitions/Identifier" },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source": { "$ref": "#/definitions/SandboxFileWriteSource" },
        "overwrite": { "type": "boolean" }
      },
      "description": "Effect identity is exact across ambiguous transport delivery. Hand retains and replays the byte-equivalent result for the same operation_id and request_digest until the target is purged; a different digest conflicts before effect."
    },
    "SandboxFileWriteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_digest", "replayed", "file"],
      "properties": {
        "operation_id": { "$ref": "#/definitions/Identifier" },
        "request_digest": { "$ref": "#/definitions/Digest" },
        "replayed": { "type": "boolean" },
        "file": { "$ref": "#/definitions/FileEntry" }
      }
    },
    "SandboxFileWriteSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "content_base64"],
          "properties": {
            "kind": { "const": "inline" },
            "content_base64": { "type": "string", "maxLength": 1398108 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "object", "fetch"],
          "properties": {
            "kind": { "const": "object" },
            "object": { "$ref": "#/definitions/ObjectReference" },
            "fetch": { "$ref": "#/definitions/ObjectTransferAuthority" }
          }
        }
      ],
      "description": "Inline content is standard padded base64 and capped at 1 MiB decoded. Larger writes carry an opaque object identity plus a one-purpose GET authority."
    },
    "SandboxCopyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_digest", "target", "expected_generation", "path", "object", "transfer", "direction", "overwrite"],
      "properties": {
        "operation_id": { "$ref": "#/definitions/Identifier" },
        "request_digest": { "$ref": "#/definitions/Digest" },
        "target": { "$ref": "#/definitions/SandboxTarget" },
        "expected_generation": { "$ref": "#/definitions/Identifier" },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "object": { "anyOf": [{ "$ref": "#/definitions/ObjectReference" }, { "type": "null" }] },
        "transfer": { "$ref": "#/definitions/ObjectTransferAuthority" },
        "direction": { "type": "string", "enum": ["import", "export"] },
        "overwrite": { "type": "boolean" }
      },
      "description": "Effect identity is exact across ambiguous transport delivery. Hand retains and replays the byte-equivalent result for the same operation_id and request_digest until the target is purged; a different digest conflicts before effect."
    },
    "SandboxCopyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_digest", "replayed", "file", "object"],
      "properties": {
        "operation_id": { "$ref": "#/definitions/Identifier" },
        "request_digest": { "$ref": "#/definitions/Digest" },
        "replayed": { "type": "boolean" },
        "file": { "$ref": "#/definitions/FileEntry" },
        "object": { "anyOf": [{ "$ref": "#/definitions/ObjectReference" }, { "type": "null" }] }
      },
      "description": "Import returns object=null. Export returns the uploaded object identity so Brain can verify and durably publish it."
    },
    "SandboxExecInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "interactive"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 131072 },
        "cwd": { "type": ["string", "null"], "maxLength": 4096 },
        "interactive": { "type": "boolean" }
      },
      "description": "Execute with /bin/bash -lc in the selected additional sandbox. Environment secrets are never accepted from model input; declared server-tool env is delivered through SecretCapability."
    },
    "SandboxExecutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "expected_generation", "execution_id", "request_digest", "input", "resources", "network"],
      "properties": {
        "target": { "$ref": "#/definitions/SandboxTarget" },
        "expected_generation": { "$ref": "#/definitions/Identifier" },
        "execution_id": { "$ref": "#/definitions/Identifier" },
        "request_digest": { "$ref": "#/definitions/Digest" },
        "input": { "$ref": "#/definitions/SandboxExecInput" },
        "resources": { "$ref": "#/definitions/ResourceCeiling" },
        "network": { "$ref": "#/definitions/NetworkCeiling" }
      }
    },
    "PrepareSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "root_id", "bindings", "bundles", "network", "resources"],
      "properties": {
        "session_id": { "$ref": "#/definitions/Identifier" },
        "root_id": { "$ref": "#/definitions/Identifier" },
        "bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/PreparedBindingBundles" }
        },
        "bundles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/BundleFetch" }
        },
        "network": { "$ref": "#/definitions/NetworkCeiling" },
        "resources": { "$ref": "#/definitions/ResourceCeiling" }
        ,"secret_capability": { "anyOf": [{ "$ref": "#/definitions/SecretCapability" }, { "type": "null" }] }
      }
    },
    "PreparedSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparation_ref"],
      "properties": {
        "preparation_ref": { "$ref": "#/definitions/Identifier" }
      }
    },
    "CreateSandboxRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "generation_intent", "resource_class", "resources", "network"],
      "properties": {
        "target": { "$ref": "#/definitions/SandboxTarget" },
        "generation_intent": { "$ref": "#/definitions/Identifier" },
        "resource_class": { "$ref": "#/definitions/Identifier" },
        "resources": { "$ref": "#/definitions/ResourceCeiling" },
        "network": { "$ref": "#/definitions/NetworkCeiling" }
      }
    },
    "WriteStdinRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_digest", "target", "expected_generation", "execution_id", "text", "eof"],
      "properties": {
        "operation_id": { "$ref": "#/definitions/Identifier" },
        "request_digest": { "$ref": "#/definitions/Digest" },
        "target": { "$ref": "#/definitions/SandboxTarget" },
        "expected_generation": { "$ref": "#/definitions/Identifier" },
        "execution_id": { "$ref": "#/definitions/Identifier" },
        "text": { "type": "string", "maxLength": 4096 },
        "eof": { "type": "boolean" }
      },
      "description": "One idempotent stdin append/EOF/poll. Empty text with eof=false is a pure poll. UTF-8 payload bytes are additionally capped at 4096 so the Hand can perform one PIPE_BUF-bounded write; larger input must be split into separately identified requests."
    },
    "WriteStdinReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_digest", "accepted", "replayed", "observation"],
      "properties": {
        "operation_id": { "$ref": "#/definitions/Identifier" },
        "request_digest": { "$ref": "#/definitions/Digest" },
        "accepted": { "type": "boolean" },
        "replayed": { "type": "boolean" },
        "observation": { "$ref": "#/definitions/OperationObservation" }
      },
      "description": "Exact stdin-effect receipt plus the current bounded observation of the referenced interactive execution. Poll requests return accepted=false and still provide the observation."
    },
    "HandErrorCode": {
      "type": "string",
      "enum": ["binding_conflict", "capability_unavailable", "operation_conflict", "operation_unknown", "sandbox_not_materialized", "sandbox_gone", "file_not_found", "generation_conflict", "invalid_request", "resource_exhausted", "temporarily_unavailable"]
    },
    "HandError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/definitions/HandErrorCode" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object", "additionalProperties": true }
      }
    }
  },
  "required": ["contract"],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods"],
      "properties": {
        "methods": {
          "const": ["resolve_binding", "submit", "observe", "cancel", "acknowledge_terminal"]
        }
      }
    }
  }
}
