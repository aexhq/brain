{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aexhq/brain/contracts/agentloop/v1/contract.json",
  "title": "Brain Agentloop v1",
  "$defs": {
    "ContextEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "items"],
      "properties": {
        "protocol_version": { "const": "agentloop/v1" },
        "items": { "type": "array", "maxItems": 4096 },
        "state": {}
      }
    },
    "Observation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "history"], "properties": { "type": { "const": "session_started" }, "history": { "type": "array" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "input"], "properties": { "type": { "const": "user_message" }, "input": { "type": "object", "additionalProperties": false, "required": ["message"], "properties": { "message": { "type": "string", "minLength": 1 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "response"], "properties": { "type": { "const": "model_completed" }, "response": {} } },
        { "type": "object", "additionalProperties": false, "required": ["type", "results"], "properties": { "type": { "const": "tools_completed" }, "results": { "type": "array", "maxItems": 128 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "event"], "properties": { "type": { "const": "emitted" }, "event": {} } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "cancelled" } } }
      ]
    },
    "ToolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "description": { "type": "string", "maxLength": 8192 },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" }
      }
    },
    "ToolInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "name", "input"],
      "properties": {
        "call_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "input": {}
      }
    },
    "Decision": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "request"], "properties": { "type": { "const": "model" }, "request": { "type": "object" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "calls"], "properties": { "type": { "const": "tools" }, "calls": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/ToolInvocation" } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "event"], "properties": { "type": { "const": "emit" }, "event": {} } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "finish" }, "result": {} } },
        { "type": "object", "additionalProperties": false, "required": ["type", "code", "message", "retryable"], "properties": { "type": { "const": "fail" }, "code": { "type": "string", "minLength": 1, "maxLength": 128 }, "message": { "type": "string", "minLength": 1, "maxLength": 4096 }, "retryable": { "type": "boolean" } } }
      ]
    },
    "ActivationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "observation", "configuration", "tools", "runtime"],
      "properties": {
        "context": { "$ref": "#/$defs/ContextEnvelope" },
        "observation": { "$ref": "#/$defs/Observation" },
        "configuration": {},
        "tools": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/ToolDefinition" } },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_time_ms", "deterministic_seed"],
          "properties": {
            "logical_time_ms": { "type": "integer", "minimum": 0 },
            "deterministic_seed": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
          }
        }
      }
    },
    "ActivationOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "decision"],
      "properties": {
        "context": { "$ref": "#/$defs/ContextEnvelope" },
        "decision": { "$ref": "#/$defs/Decision" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "input", "output"],
  "properties": {
    "contract": { "const": "agentloop/v1" },
    "input": { "$ref": "#/$defs/ActivationInput" },
    "output": { "$ref": "#/$defs/ActivationOutput" }
  }
}
