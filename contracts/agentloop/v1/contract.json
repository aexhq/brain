{
  "$defs": {
    "ContentBlock": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "input": true,
            "name": {
              "type": "string"
            },
            "type": {
              "const": "tool_use",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "name",
            "input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "content": true,
            "is_error": {
              "description": "ALWAYS set on a failed tool. Omitting the flag on a failure lets the\nmodel read that failure as a success.",
              "type": "boolean"
            },
            "tool_use_id": {
              "type": "string"
            },
            "type": {
              "const": "tool_result",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool_use_id",
            "content",
            "is_error"
          ],
          "type": "object"
        }
      ]
    },
    "Event": {
      "properties": {
        "data": true,
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "event_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "recorded_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "recorded_at_ms",
        "event_type",
        "data"
      ],
      "type": "object"
    },
    "EventId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/ContentBlock"
          },
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "type": "object"
    },
    "Role": {
      "enum": [
        "user",
        "assistant"
      ],
      "type": "string"
    },
    "RuntimeEnvelope": {
      "properties": {
        "deterministic_seed": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 32,
          "type": "array"
        },
        "logical_time_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "logical_time_ms",
        "deterministic_seed"
      ],
      "type": "object"
    },
    "ToolDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 8192,
          "type": "string"
        },
        "input_schema": {
          "type": "object"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "output_schema": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema",
        "output_schema"
      ],
      "type": "object"
    },
    "TurnInput": {
      "description": "What Brain hands the loop for one turn.",
      "properties": {
        "configuration": true,
        "events": {
          "description": "Every record on the session's feed since the loop last ran, oldest first, so a\nloop sees what happened to its environments and tools between turns.",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "input": {
          "$ref": "#/$defs/UserInput"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeEnvelope"
        },
        "slots": {
          "additionalProperties": true,
          "description": "The loop's slots by name, as it last returned them.",
          "type": "object"
        },
        "system": {
          "description": "The system prompt the session was created with. Used on every model call unless\nthe loop sends its own.",
          "maxLength": 131072,
          "type": "string"
        },
        "tools": {
          "description": "The tools the session was created with: offered whole on every model call unless\nthe loop names a subset. Brain admitted and provisioned exactly these.",
          "items": {
            "$ref": "#/$defs/ToolDefinition"
          },
          "maxItems": 128,
          "type": "array"
        },
        "transcript": {
          "description": "The transcript as it stands: what the next model call would see.",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "maxItems": 4096,
          "type": "array"
        }
      },
      "required": [
        "input",
        "transcript",
        "slots",
        "events",
        "configuration",
        "system",
        "tools",
        "runtime"
      ],
      "type": "object"
    },
    "TurnOutput": {
      "description": "What the loop hands back when the turn is done.",
      "properties": {
        "result": true,
        "slots": {
          "additionalProperties": true,
          "default": {},
          "description": "Slots to keep. A name the loop leaves out keeps its previous value.",
          "type": "object"
        },
        "transcript": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "maxItems": 4096,
          "type": "array"
        }
      },
      "required": [
        "transcript"
      ],
      "type": "object"
    },
    "UserInput": {
      "additionalProperties": false,
      "description": "What an application hands a session on `send`. The shape is closed on purpose:\nBrain owes every agentloop the same observation shape regardless of who wrote\nthe client, so free-form content is not accepted. Multimodal parts will extend\nthis record when they land — see the roadmap.",
      "properties": {
        "message": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/aexhq/brain/contracts/agentloop/v1/contract.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "agentloop/v1"
    },
    "input": {
      "$ref": "#/$defs/TurnInput"
    },
    "output": {
      "$ref": "#/$defs/TurnOutput"
    }
  },
  "required": [
    "contract",
    "input",
    "output"
  ],
  "title": "Brain Agentloop",
  "type": "object"
}
