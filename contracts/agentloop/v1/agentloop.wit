package aex:agentloop@1.0.0;

interface types {
  record context-envelope {
    protocol-version: string,
    items-json: string,
    state-json: option<string>,
  }

  variant observation {
    // JSON array of the events an application handed back at create.
    session-started(string),
    // JSON of the user-input record: {"message": string}.
    user-message(string),
    model-completed(string),
    tools-completed(string),
    emitted(string),
    cancelled,
  }

  record presentation {
    bytes: list<u8>,
    identity: string,
  }

  record runtime-envelope {
    logical-time-ms: u64,
    deterministic-seed: list<u8>,
  }

  record activation-input {
    context: context-envelope,
    observation: observation,
    configuration-json: string,
    presentation: presentation,
    runtime: runtime-envelope,
  }

  record tool-call {
    call-id: string,
    name: string,
    input-json: string,
  }

  variant decision {
    model(string),
    tools(list<tool-call>),
    emit(string),
    finish(option<string>),
    fail(tuple<string, string, bool>),
  }

  record activation-output {
    context: context-envelope,
    decision: decision,
  }

  record activation-error {
    code: string,
    message: string,
    retryable: bool,
  }
}

world agentloop {
  use types.{activation-input, activation-output, activation-error};
  export step: func(input: activation-input) -> result<activation-output, activation-error>;
}
