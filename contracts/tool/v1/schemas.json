{
  "$defs": {
    "ToolManifest": {
      "additionalProperties": false,
      "description": "The `contracts/tool/v1` manifest: the only thing Brain and environments read about\na tool. Binding *values* are never here — the manifest declares names, the\nenvironment injects values at runtime.",
      "properties": {
        "binding_names": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "maxLength": 8192,
          "type": "string"
        },
        "implementation": {
          "description": "Opaque to Brain; interpreted by the Environment driver this Tool is placed in."
        },
        "input_schema": {
          "type": "object"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "needs": {
          "description": "Resource names the program operates on; checked against the environment's\ndeclared resources at session create.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}(:[A-Za-z0-9._-]{1,64})?$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "output_schema": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema",
        "needs",
        "binding_names",
        "implementation"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/aexhq/brain/contracts/tool/v1/schemas.json",
  "$ref": "#/$defs/ToolManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brain Tool v1"
}
