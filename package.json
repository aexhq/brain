{
  "name": "brain-monorepo",
  "private": true,
  "workspaces": [
    "packages/brain-sdk",
    "examples"
  ],
  "scripts": {
    "gen": "cargo run -q -p brain-protocol --bin brain-protocol-contract && cargo run -q -p brain-http --bin brain-http-contract && cargo run -q -p brain --bin brain-contract && cargo run -q -p brain-server --bin brain-server-contract && npm run gen -w packages/brain-sdk",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tools/*.test.mjs && npm test --workspaces --if-present",
    "test:journeys": "node --test --test-concurrency=4 tests/journeys/*.test.mjs",
    "package-smoke": "node tools/package-smoke.mjs",
    "example:basic": "npm run basic -w examples",
    "example:events": "npm run events -w examples",
    "example:lifecycle": "npm run lifecycle -w examples",
    "example:http": "npm run http -w examples"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0",
    "@modelcontextprotocol/client": "2.3.1"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@openai/codex": "0.162.1",
    "@opencode/sdk": "2.0.28"
  }
}
