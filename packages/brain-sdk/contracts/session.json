{
  "$defs": {
    "AdmissionStatus": {
      "enum": [
        "admitted",
        "rejected"
      ],
      "type": "string"
    },
    "AgentloopAdmission": {
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        },
        "id": {
          "$ref": "#/$defs/AgentloopId"
        },
        "status": {
          "$ref": "#/$defs/AdmissionStatus"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    },
    "AgentloopId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "AgentloopRef": {
      "additionalProperties": false,
      "description": "The admitted Agentloop a session runs: which one, how it is configured, which\nEnvironment of the session runs it, and what it needs there.",
      "properties": {
        "configuration": true,
        "environment": {
          "$ref": "#/$defs/EnvironmentName"
        },
        "id": {
          "$ref": "#/$defs/AgentloopId"
        },
        "needs": {
          "default": [],
          "description": "What the Agentloop needs from its Environment, as URIs. Brain hands them to the\nEnvironment at setup and with every turn, and reads none of them.",
          "items": {
            "format": "uri",
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "configuration",
        "environment"
      ],
      "type": "object"
    },
    "ApiError": {
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "details": true,
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "ContentBlock": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "input": true,
            "name": {
              "type": "string"
            },
            "type": {
              "const": "tool_use",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "name",
            "input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "content": true,
            "is_error": {
              "description": "ALWAYS set on a failed tool. Omitting the flag on a failure lets the\nmodel read that failure as a success.",
              "type": "boolean"
            },
            "tool_use_id": {
              "type": "string"
            },
            "type": {
              "const": "tool_result",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool_use_id",
            "content",
            "is_error"
          ],
          "type": "object"
        }
      ]
    },
    "CreateSessionRequest": {
      "additionalProperties": false,
      "properties": {
        "agentloop": {
          "$ref": "#/$defs/AgentloopRef"
        },
        "environments": {
          "description": "The Environments of this session, set up as part of this create. Every Tool and\nthe Agentloop name one of them.",
          "items": {
            "$ref": "#/$defs/Environment"
          },
          "maxItems": 128,
          "type": "array"
        },
        "idle_ttl_ms": {
          "description": "How long the session may sit idle before Brain suspends it: its task and memory\nare released and rebuilt from disk on the next request. Absent means the server's\ndefault; zero means never.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "$ref": "#/$defs/ModelSelection"
        },
        "response_format": {
          "description": "The provider's structured-output request, applied to every model call unless the\nloop sends its own. Optional, and rejected at create for a provider that cannot\ncarry it."
        },
        "system": {
          "default": "",
          "description": "The system prompt the agent loop starts from. The loop may send a different one\non any model call.",
          "maxLength": 131072,
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/Tool"
          },
          "maxItems": 128,
          "type": "array"
        },
        "transcript": {
          "description": "A transcript to carry forward, if the caller has one: the messages the new\nsession's first model call should already see. Brain journals them as the session's\nopening transcript. Empty is an ordinary new session.",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "maxItems": 4096,
          "type": "array"
        }
      },
      "required": [
        "agentloop",
        "model",
        "tools",
        "environments"
      ],
      "type": "object"
    },
    "Environment": {
      "description": "One Environment a session declares: a name unique within the session, how Brain\nreaches it, and its own configuration, which Brain carries and never reads.",
      "oneOf": [
        {
          "description": "Hosted inside brain-server.",
          "properties": {
            "driver": {
              "const": "brain",
              "type": "string"
            }
          },
          "required": [
            "driver"
          ],
          "type": "object"
        },
        {
          "description": "The process that registered as this host, reached over the connection it holds\nopen: a browser tab, a Node process, a server.",
          "properties": {
            "driver": {
              "const": "host",
              "type": "string"
            },
            "host_id": {
              "$ref": "#/$defs/HostId"
            }
          },
          "required": [
            "driver",
            "host_id"
          ],
          "type": "object"
        },
        {
          "description": "Reached over HTTP. `credential` is sent as a bearer token; the server seals it\nbeside the model key and never journals it.",
          "properties": {
            "credential": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            },
            "driver": {
              "const": "http",
              "type": "string"
            },
            "url": {
              "format": "uri",
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "driver",
            "url"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "configuration": {
          "default": null
        },
        "name": {
          "$ref": "#/$defs/EnvironmentName"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "EnvironmentCallRequest": {
      "additionalProperties": false,
      "properties": {
        "input": true
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "EnvironmentCallResult": {
      "additionalProperties": false,
      "properties": {
        "output": true
      },
      "required": [
        "output"
      ],
      "type": "object"
    },
    "EnvironmentName": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "Event": {
      "description": "One journal record as a client reads it. `(session_id, sequence)` names it; there\nis no other identifier.",
      "properties": {
        "data": true,
        "event_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "recorded_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "recorded_at_ms",
        "event_type",
        "data"
      ],
      "type": "object"
    },
    "EventPage": {
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "next_cursor": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "events",
        "next_cursor"
      ],
      "type": "object"
    },
    "HostCommand": {
      "properties": {
        "deadline_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/HostOperation"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "session_id",
        "sequence",
        "deadline_at_ms",
        "operation"
      ],
      "type": "object"
    },
    "HostEvent": {
      "additionalProperties": false,
      "properties": {
        "data": true,
        "event_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sequence": {
          "description": "The command this Event belongs to.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "session_id",
        "sequence",
        "event_type",
        "data"
      ],
      "type": "object"
    },
    "HostEventAck": {
      "properties": {
        "sequence": {
          "description": "The sequence Brain assigned to the committed Event.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sequence"
      ],
      "type": "object"
    },
    "HostId": {
      "pattern": "^host_[A-Za-z0-9]{20,32}$",
      "type": "string"
    },
    "HostOperation": {
      "description": "What a host is asked to do for a session placed in it. A call is named by the\ncommand's `(session_id, sequence)`; the Tool's own call id never leaves Brain.",
      "oneOf": [
        {
          "properties": {
            "input": true,
            "name": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "type": {
              "const": "invoke_tool",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "input"
          ],
          "type": "object"
        },
        {
          "properties": {
            "target_sequence": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "cancel_tool",
              "type": "string"
            }
          },
          "required": [
            "type",
            "target_sequence"
          ],
          "type": "object"
        }
      ]
    },
    "HostRegistration": {
      "properties": {
        "host_id": {
          "$ref": "#/$defs/HostId"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "token"
      ],
      "type": "object"
    },
    "HostResult": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "session_id",
        "sequence",
        "outcome"
      ],
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/ContentBlock"
          },
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "type": "object"
    },
    "MessageRequest": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "$ref": "#/$defs/UserInput"
        }
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "ModelRequest": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "response_format": {
          "description": "Absent means the one the session was created with, if any. Filled in like `system`."
        },
        "system": {
          "description": "The system prompt for this call. Absent means the one the session was created\nwith; empty means none. The session fills it in before the call is journalled.",
          "type": "string"
        },
        "tools": {
          "description": "The tools to offer on this call, by name. Absent means every tool the session was\ncreated with; each name given must be one of them. Filled in like `system`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "messages"
      ],
      "type": "object"
    },
    "ModelResult": {
      "properties": {
        "message": {
          "$ref": "#/$defs/Message"
        },
        "stop_reason": {
          "$ref": "#/$defs/StopReason"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "message",
        "stop_reason",
        "usage"
      ],
      "type": "object"
    },
    "ModelSelection": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "pattern": "^\\S{1,256}$",
          "type": "string"
        },
        "provider": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name",
        "api_key"
      ],
      "type": "object"
    },
    "Outcome": {
      "description": "The one envelope every tool invocation resolves to.\n\n`timeout` is distinguished from `error` because the deadline is caller-owned: no\nbackend family can be trusted to enforce one remotely, so the caller kills and says\nexactly what happened rather than encoding it as an exit code.",
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "ok",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "status",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "$ref": "#/$defs/OutcomeError"
            },
            "status": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "type": "object"
        },
        {
          "properties": {
            "status": {
              "const": "timeout",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "status": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "message": {
              "type": "string"
            },
            "status": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "status",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "OutcomeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "details": true,
        "message": {
          "maxLength": 4096,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Role": {
      "enum": [
        "user",
        "assistant"
      ],
      "type": "string"
    },
    "SessionId": {
      "pattern": "^ses_[A-Za-z0-9]{20,32}$",
      "type": "string"
    },
    "SessionList": {
      "properties": {
        "sessions": {
          "items": {
            "$ref": "#/$defs/SessionSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "sessions"
      ],
      "type": "object"
    },
    "SessionStatus": {
      "enum": [
        "creating",
        "idle",
        "running",
        "ending",
        "ended",
        "failed"
      ],
      "type": "string"
    },
    "SessionSummary": {
      "description": "What the API says about a session: its id, where it is, and how far its journal goes.",
      "properties": {
        "last_sequence": {
          "description": "Sequence of the last journal record committed for this session — the journal is\ncomplete through here, so it is where a `GET /events` cursor starts.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        }
      },
      "required": [
        "session_id",
        "status",
        "last_sequence"
      ],
      "type": "object"
    },
    "SessionTranscript": {
      "description": "Canonical transcript as of a committed journal sequence, available without execution.",
      "properties": {
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "type": "array"
        },
        "through_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "messages",
        "through_sequence"
      ],
      "type": "object"
    },
    "StopReason": {
      "oneOf": [
        {
          "enum": [
            "end_turn",
            "tool_use",
            "max_tokens",
            "stop_sequence",
            "refusal"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The provider ended the stream without a terminal reason. Distinct from\nEndTurn on purpose: absent is never zero.",
          "type": "string"
        }
      ]
    },
    "Tool": {
      "additionalProperties": false,
      "description": "One Tool as a session declares it: what the model is told, the Environment of the\nsession that runs it, what it needs there, and the implementation that Environment\ninterprets. Brain reads the name and the Environment and carries the rest.",
      "properties": {
        "description": {
          "maxLength": 8192,
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentName"
        },
        "implementation": {
          "description": "Opaque to Brain; interpreted by the Environment. Absent when the Environment\nholds the implementation itself, as the host env does."
        },
        "input_schema": {
          "type": "object"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "needs": {
          "default": [],
          "description": "What the Tool needs from its Environment, as URIs: `pkg:` for software,\n`https:` or `wss:` for a network destination, `file:` for a filesystem location.\nBrain hands them to the Environment and reads none of them.",
          "items": {
            "format": "uri",
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "output_schema": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema",
        "environment"
      ],
      "type": "object"
    },
    "ToolAdmission": {
      "properties": {
        "error": {
          "$ref": "#/$defs/TurnError"
        },
        "id": {
          "$ref": "#/$defs/ToolId"
        },
        "status": {
          "$ref": "#/$defs/ToolAdmissionStatus"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    },
    "ToolAdmissionStatus": {
      "enum": [
        "admitted",
        "rejected"
      ],
      "type": "string"
    },
    "ToolId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ToolInvocation": {
      "description": "One call as the Agentloop makes it. `call_id` is the loop's own correlation, echoed\nin the result; on every Environment wire the call is named by its sequence.",
      "properties": {
        "call_id": {
          "type": "string"
        },
        "input": true,
        "name": {
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "name",
        "input"
      ],
      "type": "object"
    },
    "ToolResult": {
      "properties": {
        "call_id": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        },
        "output": true
      },
      "required": [
        "call_id",
        "output",
        "is_error"
      ],
      "type": "object"
    },
    "TurnDispatchRequest": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "items": {
            "$ref": "#/$defs/ToolInvocation"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "calls"
      ],
      "type": "object"
    },
    "TurnDispatchResult": {
      "properties": {
        "results": {
          "items": {
            "$ref": "#/$defs/ToolResult"
          },
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "type": "object"
    },
    "TurnEmitAck": {
      "properties": {
        "sequence": {
          "description": "The sequence Brain assigned to the committed Event.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sequence"
      ],
      "type": "object"
    },
    "TurnEmitRequest": {
      "additionalProperties": false,
      "properties": {
        "data": true,
        "event_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "event_type",
        "data"
      ],
      "type": "object"
    },
    "TurnError": {
      "description": "Why a turn, or one of the host calls inside it, failed.",
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
