package brain:agentloop@0.1.0;

// An agentloop runs one whole turn. Brain calls `turn` once per user message with the
// transcript as it stands, the loop's kv, and every event recorded since the loop
// last ran; inside the call the loop asks Brain to call the model, dispatch tools,
// save transcript and kv, emit events and publish telemetry as often as it likes.
// State writes commit before returning; turn completion returns only its result.
//
// Every payload is JSON in a string, in the shapes `contracts/session/v1` defines:
// the transcript is a list of neutral messages, a model request is a ModelRequest,
// a dispatch is a list of ToolInvocation and answers with a list of ToolResult.

interface types {
  record runtime-envelope {
    logical-time-ms: u64,
    deterministic-seed: list<u8>,
  }

  record turn-input {
    // JSON of the user-input record: {"message": string}.
    input-json: string,
    // JSON array of the neutral messages the transcript holds now.
    transcript-json: string,
    // JSON object: the loop's kv, one JSON value per key.
    kv-json: string,
    // JSON array of the events recorded since the loop's last activation, oldest first.
    events-json: string,
    configuration-json: string,
    // The system prompt the session was created with.
    system: string,
    // JSON array of the tool definitions the session was created with.
    tools-json: string,
    runtime: runtime-envelope,
  }

  record turn-output {
    // What `turn_ended` carries, if anything.
    result-json: option<string>,
  }

  record turn-error {
    code: string,
    message: string,
    retryable: bool,
  }
}

// What the loop can ask Brain to do during a turn. A call that fails after the turn was
// cancelled or ran out of budget answers with code `cancelled` or `decision_limit`; the
// loop propagates it by returning an error from `turn`.
interface host {
  use types.{turn-error};

  // A finite EventPage after this sequence. Continue with next_cursor until empty.
  events: func(after: u64) -> result<string, turn-error>;
  set-transcript: func(messages-json: string) -> result<u64, turn-error>;
  set-kv: func(key: string, value-json: string) -> result<u64, turn-error>;

  // One model call. `request-json` is a ModelRequest; the answer is a ModelResult.
  model: func(request-json: string) -> result<string, turn-error>;
  // One or many tool calls, run together. `calls-json` is a list of ToolInvocation;
  // the answer is a list of ToolResult in the same order. Calling this once per call
  // is sequential dispatch.
  dispatch: func(calls-json: string) -> result<string, turn-error>;
  // The loop's own event on the session's feed. Brain's lifecycle and effect kinds
  // are refused. Answers with the record's sequence.
  emit: func(kind: string, payload-json: string) -> result<u64, turn-error>;
  // Fire and forget.
  telemetry: func(record-json: string);
}

world agentloop {
  use types.{turn-input, turn-output, turn-error};
  import host;
  export turn: func(input: turn-input) -> result<turn-output, turn-error>;
}
