{
  "name": "@aexhq/brain",
  "version": "0.32.0",
  "description": "TypeScript SDK for an independently runnable Brain server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/brain.git",
    "directory": "packages/brain-sdk"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "exports": {
    "./environments": {
      "types": "./dist/environments.d.ts",
      "import": "./dist/environments.js"
    },
    "./package": {
      "types": "./dist/package.d.ts",
      "import": "./dist/package.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/agentloop.wit": "./contracts/agentloop.wit",
    "./contracts/tool.wit": "./contracts/tool.wit",
    "./contracts/session.json": "./contracts/session.json",
    "./contracts/*": "./contracts/*.wit",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "contracts",
    "README.md"
  ],
  "bin": {
    "brain-tools": "./bin/brain-tools.mjs",
    "brain-tool-runtime": "./bin/brain-tool-runtime.mjs"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && tsc -p test/types/tsconfig.json && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
