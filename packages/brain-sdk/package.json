{
  "name": "@aexhq/brain",
  "version": "0.16.0",
  "description": "TypeScript SDK for an independently runnable Brain server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/brain.git",
    "directory": "packages/brain-sdk"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/agentloop.wit": "./contracts/agentloop.wit",
    "./contracts/*": "./contracts/*.wit",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "contracts",
    "README.md"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
