          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "tool.result"
              ]
            },
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "at": {
              "$ref": "#/$defs/Timestamp"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "turn_id": {
              "$ref": "#/$defs/TurnId"
            },
            "agent_id": {
              "$ref": "#/$defs/AgentId"
            },
            "call_id": {
              "$ref": "#/$defs/CallId"
