    "FileEntry": {
      "type": "object",
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "dir",
            "symlink"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "modified_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      }
    },
    "FileList": {
      "type": "object",
      "required": [
        "object",
        "data",
        "synced_at",
        "source"
      ],
      "properties": {
        "object": {
          "type": "string",
          "enum": [
            "list"
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileEntry"
          }
        },
        "synced_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Time of the manifest this listing reflects; null when the workspace has never synced."
        },
        "source": {
          "type": "string",
          "enum": [
            "hand",
            "manifest"
          ],
          "description": "hand = live listing from a running hand; manifest = from the last sync (hand released)."
        }
      }
    },
    "PersistRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "path": {
          "type": "string",
          "description": "Workspace path to persist as a named, downloadable artifact."
        },
        "media_type": {
          "type": "string"
        }
      }
    },
    "Artifact": {
      "type": "object",
      "required": [
        "object",
        "session_id",
        "name",
        "bytes",
        "sha256",
        "media_type",
        "created_at"
      ],
      "properties": {
        "object": {
          "type": "string",
          "enum": [
            "artifact"
          ]
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "name": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "media_type": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "download_url": {
          "type": "string",
          "format": "uri",
          "description": "Short-lived; present on GET of a single artifact."
        },
        "download_url_expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ArtifactList": {
      "type": "object",
      "required": [
        "object",
        "data"
      ],
      "properties": {
        "object": {
          "type": "string",
          "enum": [
            "list"
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        }
      }
    },
    "ApiErrorCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Stable machine-readable code. Brain defines its core codes; a host executor may return its own code without teaching Brain product semantics."
    },
    "ApiError": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/ApiErrorCode"
        },
        "message": {
          "type": "string"
        },
        "param": {
          "type": "string",
          "description": "JSON pointer to the offending request field, when applicable."
        },
        "request_id": {
          "type": "string"
        },
        "details": {
          "description": "Machine-readable failure details when available, such as bounded validation issues."
        }
      }
    },
    "ApiErrorResponse": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      }
    }
  }
}
