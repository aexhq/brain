{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aexhq/brain/contracts/session/v1/schemas.json",
  "title": "Brain session API v1 types",
  "description": "Component types of the public session API. Paths are in openapi.yaml, which references these by $ref. Public state model: session `active | idle | deleted | failed`; hand state is a separate field. Absent provider counters are absent, never zero.",
  "$defs": {
    "SessionId": {
      "type": "string",
      "pattern": "^ses_[A-Za-z0-9]{20,32}$"
    },
    "TurnId": {
      "type": "string",
      "pattern": "^trn_[A-Za-z0-9]{20,32}$"
    },
    "AgentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "\"root\" for the session's root agent; subagents get brain-minted ids."
    },
    "CallId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Brain-minted id of one tool call (equals the ABI operation_id for hand tools)."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339, UTC."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SessionState": {
      "type": "string",
      "enum": [
        "active",
        "idle",
        "deleted",
        "failed"
      ],
      "description": "active = a turn is running or a background job is live; idle = waiting for the next message (hand may be running, suspended or released underneath); deleted = irreversible; failed = the session cannot continue (see Session.failure)."
    },
    "HandState": {
      "type": "string",
      "enum": [
        "preparing",
        "ready",
        "suspended",
        "released",
        "lost"
      ],
      "description": "preparing = the selected runtime is launching or restoring; ready = running and connected; suspended = the adapter retains runtime state without active compute; released = compute was destroyed while durable workspace state remains; lost = the Hand died mid-run (in-flight calls are interrupted and never replayed)."
    },
    "HandShape": {
      "type": "string",
      "enum": [
        "1gb",
        "2gb",
        "4gb",
        "8gb"
      ],
      "description": "Baseline memory; vCPU = memory/2; bursts to 4x. Default 1gb."
    },
    "Provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "deepseek",
        "moonshot",
        "xai",
        "openai_compatible"
      ],
      "description": "openai and anthropic are certified; the rest are available uncertified."
    },
    "ModelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "api_key"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Provider model id, e.g. \"claude-sonnet-5\" or \"gpt-5\"."
        },
        "api_key": {
          "type": "string",
          "minLength": 1,
          "writeOnly": true,
          "description": "BYOK. Encrypted per session, never returned, never logged."
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "description": "Override the provider endpoint (required for openai_compatible)."
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "Passed through where the provider supports it."
        }
      }
    },
    "ModelInfo": {
      "type": "object",
      "required": [
        "provider",
        "name"
      ],
      "description": "ModelConfig without the key.",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "name": {
          "type": "string"
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "ToolName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
    },
    "ToolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "input_schema",
        "output_schema"
      ],
      "description": "The model-visible half of one Tool. Array order is preserved exactly in the immutable model prefix.",
      "properties": {
        "name": {
          "$ref": "#/$defs/ToolName"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "input_schema": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "output_schema": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      }
    },
    "McpProtocol": {
      "type": "string",
      "enum": [
        "auto",
        "2026-07",
        "legacy"
      ],
      "description": "auto probes server/discover and falls back to the legacy adapter (initialize + Mcp-Session-Id)."
    },
    "McpServerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "description": "Prefix for its tools (\"name__tool\")."
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "writeOnly": true,
          "description": "Sent on every request (e.g. Authorization). Encrypted per session, never returned."
        },
        "protocol": {
          "$ref": "#/$defs/McpProtocol"
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Whitelist; default all."
        }
      }
    },
    "ExternalToolScope": {
      "type": "string",
      "enum": [
        "root",
        "all"
      ],
      "description": "Which agents may call a trusted server capability."
    },
    "ExternalToolCompletion": {
      "type": "string",
      "enum": [
        "continue",
        "return_direct"
      ],
      "description": "continue returns the result to the model. return_direct may complete or fail the turn without another model call."
    },
    "ExternalToolEffect": {
      "type": "string",
      "enum": [
        "opaque",
        "replay_safe"
      ],
      "description": "replay_safe promises that repeating the same session_id and call_id returns the same logical result."
    },
    "HandToolSource": {
      "type": "string",
      "enum": [
        "bundle",
        "preinstalled"
      ]
    },
    "HandToolExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol",
        "checksum",
        "source",
        "required_env"
      ],
      "description": "A checksum-sealed executable in the session's default Hand.",
      "properties": {
        "kind": {
          "type": "string",
          "const": "hand"
        },
        "protocol": {
          "type": "integer",
          "const": 1
        },
        "checksum": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "source": {
          "$ref": "#/$defs/HandToolSource"
        },
        "required_env": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": "Environment-key names only. Secret values never enter the seal."
        }
      }
    },
    "AttachedToolExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "callback_id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "attached"
        },
        "callback_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      }
    },
    "ServerToolExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capability",
        "scope",
        "completion",
        "effect",
        "max_input_bytes"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "server"
        },
        "capability": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "scope": {
          "$ref": "#/$defs/ExternalToolScope"
        },
        "completion": {
          "$ref": "#/$defs/ExternalToolCompletion"
        },
        "effect": {
          "$ref": "#/$defs/ExternalToolEffect"
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 98304
        }
      }
    },
    "IntrinsicToolExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capability"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "intrinsic"
        },
        "capability": {
          "type": "string",
          "pattern": "^brain\\.[A-Za-z0-9_.:-]{1,120}$"
        }
      }
    },
    "McpToolExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "server",
        "remote_name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "mcp"
        },
        "server": {
          "type": "string"
        },
        "remote_name": {
          "type": "string"
        }
      }
    },
    "ToolExecutor": {
      "oneOf": [
        {
          "$ref": "#/$defs/HandToolExecutor"
        },
        {
          "$ref": "#/$defs/AttachedToolExecutor"
        },
        {
          "$ref": "#/$defs/ServerToolExecutor"
        },
        {
          "$ref": "#/$defs/IntrinsicToolExecutor"
        },
        {
          "$ref": "#/$defs/McpToolExecutor"
        }
      ]
    },
    "ToolConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "executor"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/ToolDefinition"
        },
        "executor": {
          "$ref": "#/$defs/ToolExecutor"
        }
      }
    },
    "ToolBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksum",
        "content_base64",
        "bytes",
        "media_type"
      ],
      "description": "Create-time-only bundle bytes. Brain stages these outside the journal, then discards this representation.",
      "properties": {
        "checksum": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "content_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "writeOnly": true,
          "maxLength": 5592408
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "media_type": {
          "type": "string",
          "const": "application/javascript+esm"
        }
      }
    },
    "ToolsConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sealed at create with the rest of the prefix. Omitted tools default to an empty set.",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/ToolConfig"
          },
          "description": "The exact ordered native Tool grant. Omitted or empty means no native tools."
        },
        "mcp": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/McpServerConfig"
          },
          "description": "Optional remote interoperability servers. Discovery resolves once at create and appends sealed MCP Tool descriptors."
        }
      }
    },
    "HandConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "false = no sandbox; hand tools are unavailable."
        },
        "shape": {
          "$ref": "#/$defs/HandShape"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "writeOnly": true,
          "description": "Environment for the agent's shell. Encrypted per session, never returned."
        },
        "sync_interval_seconds": {
          "type": "integer",
          "minimum": 60,
          "default": 600,
          "description": "Mid-turn workspace sync period."
        },
        "max_background_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Optional cap on how long a background job may keep the hand running after the turn ends. Absent or null = no cap."
        }
      }
    },
    "HandInfo": {
      "type": "object",
      "required": [
        "state",
        "shape"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/HandState"
        },
        "shape": {
          "$ref": "#/$defs/HandShape"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "How many microVM incarnations this session has had."
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the current incarnation launched."
        },
        "wall_deadline_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the platform will sync + release this incarnation (8 h after launch)."
        },
        "last_sync_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "live_jobs": {
          "type": "integer",
          "minimum": 0,
          "description": "Background jobs still running."
        }
      }
    },
    "StorageInfo": {
      "type": "object",
      "required": [
        "workspace_bytes",
        "suspended_bytes",
        "artifact_bytes"
      ],
      "description": "Billed storage, visible from day one.",
      "properties": {
        "workspace_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Synced workspace objects (packs + manifests) in storage."
        },
        "suspended_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes retained by the selected adapter for a suspended Hand, when reported."
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "SessionFailure": {
      "type": "object",
      "required": [
        "code",
        "message",
        "at"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "tool_manifest_mismatch",
            "provider_unusable",
            "hand_unavailable",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Session": {
      "type": "object",
      "required": [
        "id",
        "object",
        "state",
        "model",
        "hand",
        "storage",
        "created_at",
        "updated_at",
        "turns",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/SessionId"
        },
        "object": {
          "type": "string",
          "enum": [
            "session"
          ]
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "model": {
          "$ref": "#/$defs/ModelInfo"
        },
        "hand": {
          "$ref": "#/$defs/HandInfo"
        },
        "storage": {
          "$ref": "#/$defs/StorageInfo"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "last_message_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "current_turn": {
          "$ref": "#/$defs/TurnId"
        },
        "failure": {
          "$ref": "#/$defs/SessionFailure"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Customer key/value; up to 16 pairs."
        }
      }
    },
    "SessionList": {
      "type": "object",
      "required": [
        "object",
        "data",
        "has_more"
      ],
      "properties": {
        "object": {
          "type": "string",
          "enum": [
            "list"
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Session"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string"
        }
      }
    },
    "FileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_base64"
      ],
      "description": "Small files placed into the workspace at create (limit 1 MiB each). Larger files: PUT /files/{path} after create.",
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative to /workspace."
        },
        "content_base64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        }
      }
    },
    "CreateSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "description": "Everything here except metadata is part of the immutable prefix: it cannot change for the life of the session.",
      "properties": {
        "model": {
          "$ref": "#/$defs/ModelConfig"
        },
        "system_prompt": {
          "type": "string"
        },
        "tools": {
          "$ref": "#/$defs/ToolsConfig"
        },
        "tool_bundles": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/ToolBundle"
          },
          "writeOnly": true,
          "description": "Bounded bundle payloads referenced by tools.items. Never part of the model prefix or journal."
        },
        "hand": {
          "$ref": "#/$defs/HandConfig"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileInput"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ContentPart": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "text"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "workspace_file"
              ]
            },
            "path": {
              "type": "string",
              "description": "A file already in the workspace; the model is told about it."
            }
          }
        }
      ]
    },
    "MessageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/ContentPart"
              }
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "MessageAccepted": {
      "type": "object",
      "required": [
        "session_id",
        "turn_id",
        "seq"
      ],
      "description": "The turn was admitted and journaled. Follow it on GET /events?after=<seq-1>.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Journal sequence of the turn.started event."
        }
      }
    },
    "ExternalToolCallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "turn_id",
        "agent_id",
        "call_id",
        "name",
        "input",
        "context"
      ],
      "description": "Generic Brain-to-host executor request. Repeating a replay_safe call uses the same session_id and call_id.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "call_id": {
          "$ref": "#/$defs/CallId"
        },
        "name": {
          "type": "string"
        },
        "input": {},
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Trusted, journaled message metadata supplied by the host, not model arguments."
        }
      }
    },
    "ExternalToolDisposition": {
      "type": "string",
      "enum": [
        "continue",
        "complete_turn",
        "fail_turn"
      ]
    },
    "ExternalToolCallResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "content",
        "is_error",
        "disposition"
      ],
      "description": "Generic trusted server-executor result. A successful response carries its structured Tool output in result. Brain honors terminal dispositions only for a return_direct tool called alone by an allowed agent.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/ToolOutcome"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 98304,
          "description": "Bounded result shown to the model and journaled as the tool result."
        },
        "is_error": {
          "type": "boolean"
        },
        "disposition": {
          "$ref": "#/$defs/ExternalToolDisposition"
        },
        "result": {
          "description": "Structured successful Tool output. Required when outcome is completed and is_error is false; also attached to turn.completed for complete_turn."
        },
        "result_metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "error": {
          "$ref": "#/$defs/ApiError",
          "description": "Turn failure attached to turn.failed when disposition is fail_turn."
        }
      }
    },
    "TurnResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "name",
        "value"
      ],
      "description": "A replayable client-facing result returned directly by a generic external tool.",
      "properties": {
        "call_id": {
          "$ref": "#/$defs/CallId"
        },
        "name": {
          "type": "string"
        },
        "value": {},
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ProviderUsage": {
      "type": "object",
      "description": "Raw provider counters for one model call. A counter the provider did not send is absent here — never reported as 0.",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ToolOutcome": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "deadline_exceeded",
        "interrupted"
      ]
    },
    "StopReason": {
      "type": "string",
      "enum": [
        "end_turn",
        "refusal",
        "max_rounds",
        "cancelled",
        "error"
      ]
    },
