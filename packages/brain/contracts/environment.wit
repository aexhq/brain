package aex:environment@1.0.0;

interface types {
  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  record extension-error {
    code: string,
    message: string,
    retryable: bool,
  }

  record http-request {
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: list<u8>,
    credential: option<string>,
    deadline-at-ms: u64,
  }

  record http-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  enum operation-state {
    pending,
    running,
    completed,
    failed,
    cancelled,
    unknown,
  }

  record resolve-request {
    tenant-id: string,
    session-id: string,
    environment-id: string,
    config-json: string,
    authority-json: string,
  }

  record resolved {
    binding-json: string,
  }

  record operation {
    operation-id: string,
    kind: string,
    descriptor-json: string,
    bundle: option<list<u8>>,
    input-json: string,
    deadline-at-ms: u64,
  }

  record submitted {
    provider-operation-id: string,
  }

  record observation {
    state: operation-state,
    cursor: string,
    chunks-json: string,
    terminal-json: option<string>,
  }
}

interface host {
  use types.{extension-error, http-request, http-response, log-level};

  cancelled: func() -> bool;
  log: func(level: log-level, message: string);
  dispatch: func(operation-id: string, action: string, request-json: string, deadline-at-ms: u64) -> result<string, extension-error>;
  http: func(request: http-request) -> result<http-response, extension-error>;
}

world environment {
  import host;
  use types.{extension-error, observation, operation, resolve-request, resolved, submitted};

  export resolve: func(request: resolve-request) -> result<resolved, extension-error>;
  export submit: func(binding-json: string, operation: operation) -> result<submitted, extension-error>;
  export observe: func(binding-json: string, provider-operation-id: string, cursor: option<string>) -> result<observation, extension-error>;
  export cancel: func(binding-json: string, provider-operation-id: string) -> result<_, extension-error>;
  export acknowledge: func(binding-json: string, provider-operation-id: string, terminal-json: string) -> result<_, extension-error>;
  export release: func(binding-json: string) -> result<_, extension-error>;
}
