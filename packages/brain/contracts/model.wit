package aex:model@1.0.0;

interface types {
  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  record extension-error {
    code: string,
    message: string,
    retryable: bool,
  }

  record http-request {
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: list<u8>,
    credential: option<string>,
    deadline-at-ms: u64,
  }

  record http-started {
    request-id: string,
  }

  record http-chunk {
    cursor: string,
    status: option<u16>,
    headers: list<tuple<string, string>>,
    bytes: list<u8>,
    done: bool,
  }

  enum event-kind {
    text-delta,
    refusal-delta,
    reasoning-delta,
    tool-use-start,
    tool-input-delta,
    usage,
  }

  enum attempt-state {
    pending,
    streaming,
    completed,
    failed,
    cancelled,
    unknown,
  }

  record request {
    operation-id: string,
    model: string,
    messages-json: string,
    tools-json: string,
    response-format-json: option<string>,
    generation-json: string,
    provider-options-json: string,
    deadline-at-ms: u64,
  }

  record started {
    provider-operation-id: string,
  }

  record event {
    cursor: string,
    kind: event-kind,
    payload-json: string,
  }

  record observation {
    state: attempt-state,
    events: list<event>,
    next-cursor: option<string>,
    terminal-json: option<string>,
  }
}

interface host {
  use types.{extension-error, http-chunk, http-request, http-started, log-level};

  cancelled: func() -> bool;
  log: func(level: log-level, message: string);
  http-start: func(operation-id: string, request: http-request) -> result<http-started, extension-error>;
  http-read: func(request-id: string, cursor: option<string>, max-bytes: u32) -> result<http-chunk, extension-error>;
  http-cancel: func(request-id: string) -> result<_, extension-error>;
}

world model {
  import host;
  use types.{extension-error, observation, request, started};

  export start: func(request: request) -> result<started, extension-error>;
  export observe: func(provider-operation-id: string, cursor: option<string>) -> result<observation, extension-error>;
  export cancel: func(provider-operation-id: string) -> result<_, extension-error>;
  export acknowledge: func(provider-operation-id: string, terminal-json: string) -> result<_, extension-error>;
}
