{
  "name": "@aexhq/loop-codex",
  "version": "1.0.0",
  "description": "The codex-style agentloop for Brain sessions: a semantic port of codex's loop policies onto contracts/agentloop/v1, built with the public @aexhq/agentloop toolchain",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/brain.git",
    "directory": "packages/loop-codex"
  },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.0.0" },
  "publishConfig": { "access": "public", "provenance": true, "tag": "next" },
  "agentloop": { "name": "codex-style" },
  "exports": {
    "./bundle": "./dist/loop.bundle.mjs",
    "./identity": "./dist/identity.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@aexhq/agentloop": "0.1.0"
  }
}
