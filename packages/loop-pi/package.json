  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/brain.git",
    "directory": "packages/loop-pi"
  },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.0.0" },
  "publishConfig": { "access": "public", "provenance": true, "tag": "next" },
  "agentloop": { "name": "pi" },
